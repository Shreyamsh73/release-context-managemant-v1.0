# Context Gateway settings. Copy this file to .env and edit.
# Every variable starts with CTX_. Provider credentials are standard env vars (see the end).

# Where sessions live: postgres or memory. Use memory for demos and tests only.
CTX_STORE=postgres
# Postgres connection string. docker compose overrides this for the gateway and worker.
CTX_DATABASE_URL=postgresql://cg:cg@localhost:5432/cg
# Redis cache for session windows. Leave empty to disable the cache.
CTX_REDIS_URL=
# How summary jobs run: inline (inside the gateway) or procrastinate (separate worker).
CTX_JOB_BACKEND=inline
# Provider client: litellm for real providers, echo for demos without credentials.
CTX_LLM_BACKEND=litellm
# Token estimation: litellm (bundled tokenizers) or heuristic (4 chars per token).
CTX_TOKEN_COUNTER=litellm

# Model used when a client sends no model or the name "default". An alias or a LiteLLM model string.
CTX_DEFAULT_MODEL=claude
# JSON map from the model name clients send to a LiteLLM model string.
# Replace the example model id with a model id enabled in your Bedrock console.
CTX_MODEL_ALIASES={"claude":"bedrock/converse/us.anthropic.claude-sonnet-4-6"}
# Allow model names that are not aliases to pass through to the provider unchanged.
CTX_ALLOW_UNLISTED_MODELS=true
# Model used for summaries. Falls back to CTX_DEFAULT_MODEL. A cheaper model works well here.
CTX_SUMMARY_MODEL=

# Maximum estimated prompt tokens the gateway sends.
CTX_CONTEXT_BUDGET_TOKENS=24000
# Start a summary job when unsummarized history exceeds this many tokens.
CTX_SUMMARY_TRIGGER_TOKENS=8000
# Newest tokens of history that a summary never folds. Must be below the trigger.
CTX_SUMMARY_KEEP_RECENT_TOKENS=3000
# Most history tokens one summary job folds. Bigger backlogs take several jobs.
CTX_SUMMARY_MAX_FOLD_TOKENS=12000
# max_tokens for the summary model call.
CTX_SUMMARY_MAX_OUTPUT_TOKENS=800
# Most recent turns loaded from storage per request.
CTX_WINDOW_MAX_TURNS=200
# Seconds a cached session window lives in Redis.
CTX_CACHE_TTL_SECONDS=600

# Comma-separated API keys that clients must send. Empty disables auth.
# Set this whenever the gateway is reachable by anyone you do not trust.
CTX_API_KEYS=
# App name used when a request does not name one.
CTX_DEFAULT_APP=default
# Comma-separated browser origins allowed by CORS. Empty disables CORS.
CTX_CORS_ORIGINS=

# Log level: DEBUG, INFO, WARNING, ERROR.
CTX_LOG_LEVEL=INFO
# Log message text and summaries. Leave false unless you are debugging.
CTX_LOG_CONTENT=false
# Bind address and port for context-gateway serve.
CTX_HOST=0.0.0.0
CTX_PORT=8080

# Provider credentials. Read by LiteLLM and boto3, not by the gateway.
# AWS Bedrock: set keys, or set AWS_PROFILE and mount ~/.aws (see docker-compose.yml).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION_NAME=us-east-1
# AWS_PROFILE=
# Other providers:
# OPENAI_API_KEY=
